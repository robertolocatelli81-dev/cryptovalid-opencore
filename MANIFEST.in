# The sdist carries what it takes to run the test suite and to check the format from the sdist alone (15/11/2026: until
# 0.24.0 it held 56 files and no test, specification, vector or CHANGELOG). Every tracked file, nothing built.
include *.py *.md *.cff LICENSE NOTICE LICENSE-Unicode-3.0.txt .gitignore .gitleaks.toml MANIFEST.in
graft spec
graft examples
graft testdata
graft docs
graft bench
graft verifiers
graft .github
prune verifiers/rust/target
prune verifiers/swift/.build
prune verifiers/js/node_modules
global-exclude __pycache__ *.py[cod] *.key .DS_Store
include tools/currency_table_from_cldr.py
